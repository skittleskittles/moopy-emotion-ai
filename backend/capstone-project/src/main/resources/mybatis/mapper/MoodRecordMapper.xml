<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="dev.capstonebackend.capstone_project.dao.MoodRecordDao">

    <resultMap id="MoodRecordMap" type="dev.capstonebackend.capstone_project.domain.MoodRecord">
        <id column="id" property="id" />
        <result column="user_id" property="userId" />
        <result column="mood_type" property="moodType" />
        <result column="mood_diary" property="moodDiary" />
        <result column="day" property="day" />
        <result column="month" property="month" />
        <result column="year" property="year" />
        <result column="created_at" property="createdAt" />
        <result column="modified_at" property="modifiedAt" />
    </resultMap>

    <!-- 插入记录 -->
    <insert id="insertMoodRecord" parameterType="dev.capstonebackend.capstone_project.domain.MoodRecord">
        INSERT INTO mood_record (user_id, mood_type, mood_diary, day, month, year)
        VALUES (#{userId}, #{moodType}, #{moodDiary}, #{day}, #{month}, #{year})
    </insert>

    <select id="selectRecordByYear" resultMap="MoodRecordMap">
        SELECT *
        FROM mood_record
        WHERE user_id = #{user_id}
        AND year = #{year}
    </select>

    <select id="selectRecordByMonth" resultMap="MoodRecordMap">
        SELECT *
        FROM mood_record
        WHERE user_id = #{user_id}
        AND year = #{year}
        AND month = #{month}
    </select>

    <select id="selectRecordByUserId" parameterType="java.lang.Long" resultMap="MoodRecordMap">
        SELECT *
        FROM mood_record
        WHERE user_id = #{user_id}
    </select>

</mapper>
