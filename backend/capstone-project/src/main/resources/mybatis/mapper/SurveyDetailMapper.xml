<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="dev.capstonebackend.capstone_project.dao.SurveyDetailDao">

    <resultMap id="SurveyDetailMap" type="dev.capstonebackend.capstone_project.domain.SurveyDetail">
        <id column="id" property="id" />
        <result column="user_id" property="userId" />
        <result column="survey_id" property="surveyId" />
        <result column="question_number" property="questionNumber" />
        <result column="answer_index" property="answerIndex" />
        <result column="created_at" property="createdAt" />
        <result column="modified_at" property="modifiedAt" />
    </resultMap>

    <!-- 插入用户 -->
    <insert id="batchInsertDetail" parameterType="java.util.List">
        INSERT INTO survey_detail (
            user_id, survey_id, question_number, answer_index
        )
        VALUES
        <foreach collection="surveyDetailList" item="item" separator=",">
            (
                #{item.userId},
                #{item.surveyId},
                #{item.questionNumber},
                #{item.answerIndex}
            )
        </foreach>
    </insert>

    <select id="selectBySurveyIdList" parameterType="java.util.Objects" resultMap="SurveyDetailMap">
        SELECT *
        FROM survey_detail
        WHERE survey_id IN
        <foreach item="surveyId" collection="surveyIdList" open="(" separator="," close=")">
            #{surveyId}
        </foreach>

    </select>


</mapper>
